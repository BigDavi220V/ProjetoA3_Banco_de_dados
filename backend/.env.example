# ================================================================
# Caderneta Digital da Criança — variáveis de ambiente
# Copie para ".env" (mesma pasta) e ajuste.  NUNCA suba o .env no Git.
# ================================================================

# ----- Servidor web -----
PORT=3000

# ----- SQL Server na VM (VirtualBox) -----
# IP da VM (rede "Placa em modo Bridge" ou "Host-only") ou localhost com redirecionamento de porta
DB_SERVER=192.168.56.101
DB_PORT=1433
DB_NAME=CadernetaDigital
DB_ENCRYPT=false

# Usuário da APLICAÇÃO (criado pelo script 05_dcl, só tem as permissões necessárias)
DB_USER=app_caderneta
DB_PASSWORD=Caderneta@A3_2026

# Usuário ADMINISTRADOR, usado só pelo "npm run db:setup" (cria banco, tabelas e logins)
DB_ADMIN_USER=sa
DB_ADMIN_PASSWORD=SuaSenhaDoSa@2026

# ----- Autenticação -----
JWT_SECRET=troque_por_um_texto_longo_e_aleatorio
JWT_EXPIRES_IN=8h
