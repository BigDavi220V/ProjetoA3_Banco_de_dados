%% Módulo C — Usuários, perfis, permissões e auditoria (escopo = 1 unidade por usuário)
erDiagram
  UNIDADE_SAUDE ||--o{ USUARIO : "atua em"
  PERFIL ||--o{ USUARIO : "define"
  PERFIL ||--o{ PERFIL_PERMISSAO : "concede"
  PERMISSAO ||--o{ PERFIL_PERMISSAO : "é concedida"
  PROFISSIONAL |o--o| USUARIO : "pode ser"
  UNIDADE_SAUDE ||--o{ PROFISSIONAL : "lota"
  USUARIO |o--o{ LOG_AUDITORIA : "autor"

  USUARIO {
    int usuario_id PK
    int perfil_id FK
    int unidade_id FK
    int profissional_id FK, UK
    string nome
    string login UK
    string senha_hash
    bool ativo
    datetime ultimo_acesso
  }
  PERFIL {
    int perfil_id PK
    string codigo UK
    string nome
    string descricao
  }
  PERMISSAO {
    int permissao_id PK
    string codigo UK
    string modulo
    string descricao
  }
  PERFIL_PERMISSAO {
    int perfil_id PK, FK
    int permissao_id PK, FK
  }
  PROFISSIONAL {
    int profissional_id PK
    int unidade_id FK
    int especialidade_id FK
    string nome
    string cpf UK
    string conselho
    string registro_conselho
    string cbo
    bool ativo
  }
  UNIDADE_SAUDE {
    int unidade_id PK
    string cnes UK
    string nome
    string tipo
    string endereco
    string telefone
    bool ativo
  }
  LOG_AUDITORIA {
    bigint log_id PK
    int usuario_id FK
    string tabela
    string operacao
    string chave
    string dados_antes
    string dados_depois
    datetime data_hora
  }
